    "i18next": "^26.3.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.3.2",
    "lightweight-charts": "^4.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "sonner": "^2.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
