# .env.example — cQuant 环境变量模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 Git。

# ── 数据源 API Keys ────────────────────────────────────────────────────────────
# Tushare Pro Token（A 股日线、基本面、交易日历、复权因子）
# 注册：https://tushare.pro/register
TUSHARE_TOKEN=

# Wind 金融终端 API（付费，可选）
# WIND_USER=
# WIND_PASSWORD=

# 同花顺 iFind（付费，可选）
# IFIND_USER=
# IFIND_PASSWORD=

# ── AI / LLM API Keys ─────────────────────────────────────────────────────────
# Anthropic Claude API（ai_advisor 主要 Provider，Phase 3）
# 获取：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API（ai_advisor 备用 Provider，Phase 3）
# 获取：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama 本地模型地址（Phase 3，可选）
# OLLAMA_BASE_URL=http://localhost:11434

# ── 平台 API 认证 ─────────────────────────────────────────────────────────────
# API Server 自身的访问令牌（与数据源 Token 无关）。
# 设置后所有 /api/v1/* 请求需携带 "Authorization: Bearer <key>"；
# 前端在「设置」页面粘贴一次即可（保存在浏览器 localStorage）。
# 生成：python -m cquant.cli.main auth generate-key
# 详见 docs/security.md
CQUANT_API_KEY=

# 本地开发逃生口：未设 Key 时放行非交易端点（/trading/* 仍需 Key）。
# 设置了 CQUANT_API_KEY 后此变量无效。生产环境严禁 dev。
# CQUANT_AUTH_MODE=strict

# ── 数据库与存储路径 ───────────────────────────────────────────────────────────
# DuckDB catalog 文件路径（相对于项目根目录）
CQUANT_DB_PATH=data/catalog.duckdb

# Parquet lake 根目录
CQUANT_LAKE_ROOT=data/lake

# 知识库数据目录（Phase 3）
CQUANT_KNOWLEDGE_ROOT=knowledge

# ── MLflow 实验追踪（Phase 2）─────────────────────────────────────────────────
# 本地 MLflow tracking server URI
# 启动：mlflow server --host 0.0.0.0 --port 5000
MLFLOW_TRACKING_URI=http://localhost:5000

# 实验名称（默认）
MLFLOW_EXPERIMENT_NAME=cquant_default

# ── 回测默认参数覆盖 ───────────────────────────────────────────────────────────
# 初始资金（CNY）
# CQUANT_INITIAL_CASH=1000000

# 默认市场
# CQUANT_DEFAULT_MARKET=CN

# ── 开发 / 调试 ────────────────────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
CQUANT_LOG_LEVEL=INFO

# 是否启用详细回测日志
# CQUANT_BACKTEST_VERBOSE=false
